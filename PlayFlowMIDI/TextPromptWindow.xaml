<Window x:Class="PlayFlowMIDI.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayFlowMIDI" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        Background="#121212" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock x:Name="PromptText" Foreground="#CCCCCC" Margin="0,0,0,4"/>
        <TextBox x:Name="ValueBox" Height="26" VerticalContentAlignment="Center" TextChanged="ValueBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="#FF7F7F" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" MinHeight="18"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="OkButton" Content="OK" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="Cancel" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
